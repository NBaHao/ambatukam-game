// Một Worker phục vụ cả game (React build ở ../frontend/dist) lẫn API leaderboard FastAPI (/api/*).
// /api/* luôn chạy vào Python (src/entry.py); đường dẫn khác trả file tĩnh nếu có.
// Chạy qua pywrangler (uv run pywrangler dev|deploy) để nó đóng gói thư viện Python trong pyproject.toml.
{
  "name": "ambatukam",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    // /c/<code> (challenge links) goes through the Worker too, to put the room in the link preview (entry.py)
    "run_worker_first": ["/api/*", "/c/*"],
    // /u/<name> (profiles) and other app paths: serve index.html, the app reads the path
    "not_found_handling": "single-page-application"
  },
  // Tên miền riêng: Cloudflare tự tạo bản ghi DNS + chứng chỉ SSL khi deploy (zone bahao.site nằm trên Cloudflare).
  "routes": [{ "pattern": "ambatukam.bahao.site", "custom_domain": true }],
  // Chỉ phục vụ qua tên miền riêng: tắt link *.workers.dev và link xem trước của từng phiên bản
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ambatukam-leaderboard",
      "database_id": "2a050a93-08f2-4d52-b193-e340203002ca",
      "migrations_dir": "migrations"
    }
  ],
  // One PvP room per challenge code (src/pvp_room.py) and one global lobby for presence and invites
  // (src/lobby_room.py). SQLite-backed: available on the free plan. Never edit an applied tag.
  "durable_objects": {
    "bindings": [
      { "name": "PVP_ROOM", "class_name": "PvpRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PvpRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] }
  ],
  // Giới hạn số request theo IP (period chỉ được 10 hoặc 60 giây)
  "ratelimits": [
    { "name": "SESSION_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "SCORE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    // Login attempts per username (any IP)
    { "name": "LOGIN_NAME_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    // PvP rooms created per IP
    { "name": "ROOM_LIMIT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } }
  ]
  // Secret (không ghi ở đây): TOKEN_SECRET, TURNSTILE_SECRET.
  // Production: `uv run pywrangler secret put <NAME>`. Local: backend/.dev.vars (mẫu trong .dev.vars.example).
}
