# Monorepo: frontend/ (React + Vite) và backend/ (FastAPI trên Cloudflare Python Workers).
# Một file ignore cho cả repo.

# Hệ điều hành / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Log, file tạm
*.log
_debug/

# Secret và cấu hình riêng từng máy: không bao giờ commit (chỉ commit file *.example).
# frontend/.env.development và .env.production chỉ chứa giá trị công khai nên được commit.
.env
.env.local
.env.*.local
*.local
.dev.vars
.dev.vars.*
backend/.env.*
!*.example

# Wrangler local state (D1 local, cache)
.wrangler/

# Frontend (Node / Vite)
node_modules/
dist/
coverage/
*.tsbuildinfo

# Backend (Python / uv / pywrangler)
__pycache__/
.venv/
.venv-workers/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
python_modules/
pylock.toml
