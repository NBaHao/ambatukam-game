# Biến môi trường của frontend (Vite). Mọi biến VITE_* bị nhúng thẳng vào bundle JS gửi cho trình duyệt:
# chỉ để giá trị CÔNG KHAI ở đây, tuyệt đối không để secret.
#
# Vite tự nạp theo mode: .env.development (npm run dev), .env.production (npm run build).
# Muốn ghi đè trên máy mình thì tạo .env.development.local / .env.production.local (đã gitignore).

# Sitekey Cloudflare Turnstile (công khai). Dashboard → Turnstile → widget "ambatukam".
# Khoá thử luôn qua: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Gốc URL của API. Để trống = cùng tên miền với trang (production và Vite proxy khi dev).
VITE_API_BASE_URL=

# Chỉ dùng cho `npm run dev` (không có tiền tố VITE_ nên không vào bundle): Worker FastAPI mà Vite proxy /api tới.
# Mặc định http://localhost:8787 (`make dev-api`). Đổi thì đặt trong .env.development.local.
# API_DEV_URL=http://localhost:8787
