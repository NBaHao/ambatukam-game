# Biến môi trường của frontend (Vite). Mọi file .env* đều bị gitignore, chỉ commit file mẫu này.
# Chạy local:  cp frontend/.env.example frontend/.env.development   (hoặc `make install` tự copy)
#
# Mọi biến VITE_* bị nhúng thẳng vào bundle JS gửi cho trình duyệt: chỉ để giá trị CÔNG KHAI, tuyệt đối không để secret.
#
# Production KHÔNG đọc file này: Cloudflare Workers Builds truyền biến qua
# Settings → Build → Variables and secrets. Build production thiếu sitekey hoặc dùng khoá thử sẽ báo lỗi (vite.config.ts).

# Sitekey Cloudflare Turnstile (công khai). Đây là khoá thử, luôn qua, khớp TURNSTILE_SECRET trong backend/.dev.vars.example.
# Khoá thật: dashboard → Turnstile → widget "ambatukam".
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Gốc URL của API. Để trống = cùng tên miền với trang (production và Vite proxy khi dev).
VITE_API_BASE_URL=

# Chỉ dùng cho `npm run dev` (không có tiền tố VITE_ nên không vào bundle): Worker FastAPI mà Vite proxy /api tới.
# Mặc định http://localhost:8787 (`make dev-api`).
# API_DEV_URL=http://localhost:8787
